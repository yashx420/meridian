# Anthropic API key (required for the AI consultation / chat features)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model used for all AI calls. Override if your key targets a different model.
ANTHROPIC_MODEL=claude-opus-4-5

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=please-change-this-to-a-long-random-string
# How long a login stays valid.
JWT_TTL=30d

# Server port.
PORT=8787

# Where the SQLite database file and uploaded files live (relative to where you
# start the server, or absolute paths).
DB_PATH=./data/meridian.db
UPLOAD_DIR=./uploads
