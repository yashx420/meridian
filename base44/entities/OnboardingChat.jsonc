{
  "name": "OnboardingChat",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "twin",
        "org"
      ],
      "description": "Which onboarding flow: Digital Twin or Org Twin"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "seneca"
            ]
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Array of conversation messages"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "mode"
  ]
}